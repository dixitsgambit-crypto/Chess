{
  "name": "ai-chess-academy",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "server": "node --experimental-strip-types server/index.ts",
    "start": "node --experimental-strip-types server/index.ts --production",
    "build": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json && vite build",
    "test": "node --experimental-strip-types scripts/check-pgn.ts && node --experimental-strip-types scripts/validate-content.ts && npm run test:server",
    "test:server": "node --test server/test/api.test.ts server/test/data.test.ts server/test/lab.test.ts server/test/rules.test.ts server/test/serving.test.ts server/test/engine.test.ts",
    "validate": "node --experimental-strip-types scripts/validate-content.ts --verbose",
    "verify:engine": "node --experimental-strip-types scripts/verify-engine.ts",
    "backup": "node --experimental-strip-types scripts/backup.ts"
  },
  "dependencies": {
    "chess.js": "1.0.0",
    "chessground": "9.1.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "stockfish": "16.0.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.1",
    "typescript": "5.5.4",
    "vite": "5.4.2"
  }
}
